<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.iboot</groupId>
        <artifactId>iboot</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>iboot-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        后端 Server 的主项目，通过引入需要 iboot-module-xxx 的依赖，
        从而实现提供 RESTful API 给 iboot-ui-admin、iboot-ui-user 等前端项目。
        本质上来说，它就是个空壳（容器）！
    </description>
    <url>https://github.com/YunaiV/ruoyi-vue-pro</url>

    <dependencies>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 基础设施 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 工作流 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-bpm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- MES 制造执行系统相关模块 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-mdm</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-mes</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- WMS 仓库管理模块 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-wms</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- APS 高级计划排程模块 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-aps</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 数据报表。默认注释，保证编译速度 -->
<!--        <dependency>-->
<!--            <groupId>com.iboot</groupId>-->
<!--            <artifactId>iboot-module-report</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

        <!-- AI 大模型相关模块。默认注释，保证编译速度 -->
<!--        <dependency>-->
<!--            <groupId>com.iboot</groupId>-->
<!--            <artifactId>iboot-module-ai</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

        <!-- IoT 物联网相关模块。默认注释，保证编译速度 -->
<!--        <dependency>-->
<!--            <groupId>com.iboot</groupId>-->
<!--            <artifactId>iboot-module-iot-biz</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

        <!-- HRM 人力资源管理模块。默认注释，保证编译速度 -->
<!--        <dependency>-->
<!--            <groupId>com.iboot</groupId>-->
<!--            <artifactId>iboot-module-hrm</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-protection</artifactId>
        </dependency>

        <!-- Test 测试相关（跨模块集成测试：H2 内存库 + jedis-mock 内嵌 Redis，T6-01） -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          微信生态（wx-java）的 mp / open starter 在 iboot-module-system 里是 compile 依赖，
          它们的 auto-config 需要 Apache HttpClient，但该依赖没有随 starter 传递进来。
          生产打包时类路径上恰好有（别的 starter 带进来的），跑 mvn test 时 iboot-server
          的测试类路径上没有，一装配上下文就
          ClassNotFoundException: org.apache.http.conn.HttpClientConnectionManager。
          SocialClientServiceImpl 又是 @Resource 强注入 WxMpService，不能靠排除 auto-config 绕开，
          只能把 HttpClient 补进测试类路径。
        -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.13</version>
            <scope>test</scope>
        </dependency>

        <!--
          H2 降到 2.2.224（工程默认 2.3.232）只为集成测试：Flowable 8.0.0 的 H2 方言
          建 ACT_* 表时写的是 `ID_ identity`，而 H2 2.3.x 移除了 IDENTITY 这个遗留数据类型，
          database-schema-update=true 一执行就抛
          Unknown data type: "IDENTITY"，流程引擎 Bean 建不出来、整个上下文起不来。
          H2 2.2.224 仍认 identity，是 Flowable 8 实际支持的版本区间。
          作用域限 test，不影响生产运行。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 jar 打入其中 -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
