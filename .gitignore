# 根目录 sql/ 保留芋道上游原生脚本（mysql/ oracle/ postgresql/ 等），不入库。
# 但 T5-04 的交付脚本 sql/deploy/ 是本项目自己的产物，必须入库 —— 故用
# 否定规则放行。注意必须先写 /sql/* 再写 !/sql/deploy/，git 对已排除目录
# 内的文件不会重新包含，所以要用 /sql/* 而非 /sql/。
/sql/*
!/sql/deploy/
业务建模/
.zcode/

# lefthook 在仓库根目录执行 pnpm install 时自动生成的示例模板（全注释，无实际规则）。
# 真正生效的配置是 iboot-ui/iboot-ui-admin-vben/lefthook.yml，勿提交根目录这份。
/lefthook.yml

.workbuddy/
.tmp-codegen/
.arts/
.codeartsdoer/
.claude/
.codex/
# H2 建表脚本转换器的中间产物（script/h2-schema-convert.py 从开发库导出的原始 DDL 缓存，
# 可从数据库重新生成，不入库；见 T6-01）
script/h2-schema-convert-raw/
script/__pycache__/
iboot-server/LOG_FILE_IS_UNDEFINED
