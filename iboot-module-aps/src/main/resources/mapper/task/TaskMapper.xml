<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.task.TaskMapper">

    <sql id="selectColumns">
        t.*
        , version.version_no AS version_version_no
    </sql>

    <sql id="joinTables">
        FROM aps_task t
        LEFT JOIN aps_version version ON version.id = t.version_id AND version.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.taskNo != null and req.taskNo != ''">
                AND t.task_no = #{req.taskNo}
            </if>
            <if test="req.prodOrderId != null">
                AND t.prod_order_id = #{req.prodOrderId}
            </if>
            <if test="req.prodOrderNo != null and req.prodOrderNo != ''">
                AND t.prod_order_no = #{req.prodOrderNo}
            </if>
            <if test="req.workOrderId != null">
                AND t.work_order_id = #{req.workOrderId}
            </if>
            <if test="req.opTaskId != null">
                AND t.op_task_id = #{req.opTaskId}
            </if>
            <if test="req.routeOpId != null">
                AND t.route_op_id = #{req.routeOpId}
            </if>
            <if test="req.opCode != null and req.opCode != ''">
                AND t.op_code = #{req.opCode}
            </if>
            <if test="req.opName != null and req.opName != ''">
                AND t.op_name LIKE CONCAT('%', #{req.opName}, '%')
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.projectTaskId != null">
                AND t.project_task_id = #{req.projectTaskId}
            </if>
            <if test="req.resId != null">
                AND t.res_id = #{req.resId}
            </if>
            <if test="req.resCode != null and req.resCode != ''">
                AND t.res_code = #{req.resCode}
            </if>
            <if test="req.startTime != null">
                AND t.start_time = #{req.startTime}
            </if>
            <if test="req.endTime != null">
                AND t.end_time = #{req.endTime}
            </if>
            <if test="req.durationMinutes != null">
                AND t.duration_minutes = #{req.durationMinutes}
            </if>
            <if test="req.sequenceNo != null">
                AND t.sequence_no = #{req.sequenceNo}
            </if>
            <if test="req.lockedFlag != null">
                AND t.locked_flag = #{req.lockedFlag}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.task.vo.TaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.task.vo.TaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>