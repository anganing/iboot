<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.tasklock.ApsTaskLockMapper">

    <sql id="selectColumns">
        t.*
        , task.task_no AS task_no
        , task.op_code AS op_code
        , task.op_name AS op_name
        , task.res_code AS res_code
    </sql>

    <sql id="joinTables">
        FROM aps_task_lock t
        LEFT JOIN aps_task task ON task.id = t.task_id AND task.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.taskId != null">
                AND t.task_id = #{req.taskId}
            </if>
            <if test="req.lockType != null and req.lockType != ''">
                AND t.lock_type = #{req.lockType}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.lockedBy != null">
                AND t.locked_by = #{req.lockedBy}
            </if>
            <if test="req.lockedTime != null and req.lockedTime.length == 2">
                AND t.locked_time BETWEEN #{req.lockedTime[0]} AND #{req.lockedTime[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.tasklock.vo.TaskLockRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.tasklock.vo.TaskLockRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
