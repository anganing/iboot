<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.projectionresource.ProjectionResourceMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_projection_resource t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.sourceResId != null">
                AND t.source_res_id = #{req.sourceResId}
            </if>
            <if test="req.resCode != null and req.resCode != ''">
                AND t.res_code = #{req.resCode}
            </if>
            <if test="req.resName != null and req.resName != ''">
                AND t.res_name LIKE CONCAT('%', #{req.resName}, '%')
            </if>
            <if test="req.resType != null and req.resType != ''">
                AND t.res_type = #{req.resType}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.wcId != null">
                AND t.wc_id = #{req.wcId}
            </if>
            <if test="req.workDate != null">
                AND t.work_date = #{req.workDate}
            </if>
            <if test="req.shiftId != null">
                AND t.shift_id = #{req.shiftId}
            </if>
            <if test="req.availableMinutes != null">
                AND t.available_minutes = #{req.availableMinutes}
            </if>
            <if test="req.capabilityJson != null and req.capabilityJson != ''">
                AND t.capability_json = #{req.capabilityJson}
            </if>
            <if test="req.sourceUpdateTime != null">
                AND t.source_update_time = #{req.sourceUpdateTime}
            </if>
            <if test="req.snapshotTime != null">
                AND t.snapshot_time = #{req.snapshotTime}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.projectionresource.vo.ProjectionResourceRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.projectionresource.vo.ProjectionResourceRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>