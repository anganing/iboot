<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.scenario.ScenarioMapper">

    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM aps_scenario t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.code != null and req.code != ''">
                AND t.code = #{req.code}
            </if>
            <if test="req.name != null and req.name != ''">
                AND t.name LIKE CONCAT('%', #{req.name}, '%')
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.strategyId != null">
                AND t.strategy_id = #{req.strategyId}
            </if>
            <if test="req.planStartTime != null">
                AND t.plan_start_time = #{req.planStartTime}
            </if>
            <if test="req.planEndTime != null">
                AND t.plan_end_time = #{req.planEndTime}
            </if>
            <if test="req.snapshotTime != null">
                AND t.snapshot_time = #{req.snapshotTime}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.scenario.vo.ScenarioRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.scenario.vo.ScenarioRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>