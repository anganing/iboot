<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.projection.ApsMaterialProjectionMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_projection_mat t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.scenarioId != null">
                AND t.scenario_id = #{req.scenarioId}
            </if>
            <if test="req.sourceMatId != null">
                AND t.source_mat_id = #{req.sourceMatId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code LIKE CONCAT('%', #{req.matCode}, '%')
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.matType != null and req.matType != ''">
                AND t.mat_type = #{req.matType}
            </if>
            <if test="req.batchFlag != null">
                AND t.batch_flag = #{req.batchFlag}
            </if>
            <if test="req.snapshotTime != null and req.snapshotTime.length == 2">
                AND t.snapshot_time BETWEEN #{req.snapshotTime[0]} AND #{req.snapshotTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.aps.controller.admin.projectionmat.vo.ProjectionMatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.mat_code ASC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.aps.controller.admin.projectionmat.vo.ProjectionMatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
