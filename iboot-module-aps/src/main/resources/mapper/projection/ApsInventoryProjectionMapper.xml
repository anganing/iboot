<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.projection.ApsInventoryProjectionMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_projection_inv t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.scenarioId != null">
                AND t.scenario_id = #{req.scenarioId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code LIKE CONCAT('%', #{req.matCode}, '%')
            </if>
            <if test="req.whId != null">
                AND t.wh_id = #{req.whId}
            </if>
            <if test="req.locId != null">
                AND t.loc_id = #{req.locId}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no LIKE CONCAT('%', #{req.lotNo}, '%')
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.stockScope != null and req.stockScope != ''">
                AND t.stock_scope = #{req.stockScope}
            </if>
            <if test="req.qualityStatus != null and req.qualityStatus != ''">
                AND t.quality_status = #{req.qualityStatus}
            </if>
            <if test="req.snapshotTime != null and req.snapshotTime.length == 2">
                AND t.snapshot_time BETWEEN #{req.snapshotTime[0]} AND #{req.snapshotTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.aps.controller.admin.projectioninv.vo.ProjectionInvRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.mat_code ASC, t.lot_no ASC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.aps.controller.admin.projectioninv.vo.ProjectionInvRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
