<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.projectionmat.ProjectionMatMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_projection_mat t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.sourceMatId != null">
                AND t.source_mat_id = #{req.sourceMatId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.matSpec != null and req.matSpec != ''">
                AND t.mat_spec = #{req.matSpec}
            </if>
            <if test="req.matType != null and req.matType != ''">
                AND t.mat_type = #{req.matType}
            </if>
            <if test="req.baseUomId != null">
                AND t.base_uom_id = #{req.baseUomId}
            </if>
            <if test="req.baseUomCode != null and req.baseUomCode != ''">
                AND t.base_uom_code = #{req.baseUomCode}
            </if>
            <if test="req.batchFlag != null">
                AND t.batch_flag = #{req.batchFlag}
            </if>
            <if test="req.bomId != null">
                AND t.bom_id = #{req.bomId}
            </if>
            <if test="req.bomVersion != null and req.bomVersion != ''">
                AND t.bom_version = #{req.bomVersion}
            </if>
            <if test="req.routeId != null">
                AND t.route_id = #{req.routeId}
            </if>
            <if test="req.routeVersion != null and req.routeVersion != ''">
                AND t.route_version = #{req.routeVersion}
            </if>
            <if test="req.sourceUpdateTime != null">
                AND t.source_update_time = #{req.sourceUpdateTime}
            </if>
            <if test="req.snapshotTime != null">
                AND t.snapshot_time = #{req.snapshotTime}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.projectionmat.vo.ProjectionMatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.projectionmat.vo.ProjectionMatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>