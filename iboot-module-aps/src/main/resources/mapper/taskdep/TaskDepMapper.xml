<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.taskdep.TaskDepMapper">

    <sql id="selectColumns">
        t.*
        , version.version_no AS version_version_no
    </sql>

    <sql id="joinTables">
        FROM aps_task_dep t
        LEFT JOIN aps_version version ON version.id = t.version_id AND version.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.fromTaskId != null">
                AND t.from_task_id = #{req.fromTaskId}
            </if>
            <if test="req.toTaskId != null">
                AND t.to_task_id = #{req.toTaskId}
            </if>
            <if test="req.depType != null and req.depType != ''">
                AND t.dep_type = #{req.depType}
            </if>
            <if test="req.lagMinutes != null">
                AND t.lag_minutes = #{req.lagMinutes}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.taskdep.vo.TaskDepRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.taskdep.vo.TaskDepRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>