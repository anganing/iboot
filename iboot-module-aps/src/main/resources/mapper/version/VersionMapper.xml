<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.version.VersionMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_version t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.versionNo != null">
                AND t.version_no = #{req.versionNo}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.score != null and req.score != ''">
                AND t.score = #{req.score}
            </if>
            <if test="req.hardScore != null">
                AND t.hard_score = #{req.hardScore}
            </if>
            <if test="req.softScore != null">
                AND t.soft_score = #{req.softScore}
            </if>
            <if test="req.solveStartTime != null">
                AND t.solve_start_time = #{req.solveStartTime}
            </if>
            <if test="req.solveEndTime != null">
                AND t.solve_end_time = #{req.solveEndTime}
            </if>
            <if test="req.publishedTime != null">
                AND t.published_time = #{req.publishedTime}
            </if>
            <if test="req.publishedBy != null">
                AND t.published_by = #{req.publishedBy}
            </if>
            <if test="req.solverMessage != null and req.solverMessage != ''">
                AND t.solver_message = #{req.solverMessage}
            </if>
            <if test="req.version != null">
                AND t.version = #{req.version}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.version.vo.VersionRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.version.vo.VersionRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>