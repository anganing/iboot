<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.load.ApsLoadMapper">

    <sql id="selectColumns">
        t.*
        , version.version_no AS version_version_no
    </sql>

    <sql id="joinTables">
        FROM aps_load t
        LEFT JOIN aps_version version ON version.id = t.version_id AND version.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.resId != null">
                AND t.res_id = #{req.resId}
            </if>
            <if test="req.resCode != null and req.resCode != ''">
                AND t.res_code = #{req.resCode}
            </if>
            <if test="req.resName != null and req.resName != ''">
                AND t.res_name LIKE CONCAT('%', #{req.resName}, '%')
            </if>
            <if test="req.workDate != null">
                AND t.work_date = #{req.workDate}
            </if>
            <if test="req.loadMinutes != null">
                AND t.load_minutes = #{req.loadMinutes}
            </if>
            <if test="req.capacityMinutes != null">
                AND t.capacity_minutes = #{req.capacityMinutes}
            </if>
            <if test="req.loadRate != null">
                AND t.load_rate = #{req.loadRate}
            </if>
            <if test="req.overloadMinutes != null">
                AND t.overload_minutes = #{req.overloadMinutes}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.load.vo.LoadRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.load.vo.LoadRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

    <select id="selectListByVersionId" resultType="com.iboot.pf.module.aps.controller.admin.load.vo.LoadRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.version_id = #{versionId}
        ORDER BY t.id DESC
    </select>

</mapper>