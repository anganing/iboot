<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.aps.dal.mysql.projectioninv.ProjectionInvMapper">

    <sql id="selectColumns">
        t.*
        , scenario.code AS scenario_code
        , scenario.name AS scenario_name
    </sql>

    <sql id="joinTables">
        FROM aps_projection_inv t
        LEFT JOIN aps_scenario scenario ON scenario.id = t.scenario_id AND scenario.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.sourceBalanceId != null">
                AND t.source_balance_id = #{req.sourceBalanceId}
            </if>
            <if test="req.invOrgId != null">
                AND t.inv_org_id = #{req.invOrgId}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.whId != null">
                AND t.wh_id = #{req.whId}
            </if>
            <if test="req.locId != null">
                AND t.loc_id = #{req.locId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.batchId != null">
                AND t.batch_id = #{req.batchId}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.projectTaskId != null">
                AND t.project_task_id = #{req.projectTaskId}
            </if>
            <if test="req.stockScope != null and req.stockScope != ''">
                AND t.stock_scope = #{req.stockScope}
            </if>
            <if test="req.qualityStatus != null and req.qualityStatus != ''">
                AND t.quality_status = #{req.qualityStatus}
            </if>
            <if test="req.qtyOnhand != null">
                AND t.qty_onhand = #{req.qtyOnhand}
            </if>
            <if test="req.qtyReserved != null">
                AND t.qty_reserved = #{req.qtyReserved}
            </if>
            <if test="req.qtyFrozen != null">
                AND t.qty_frozen = #{req.qtyFrozen}
            </if>
            <if test="req.qtyAvailable != null">
                AND t.qty_available = #{req.qtyAvailable}
            </if>
            <if test="req.sourceUpdateTime != null">
                AND t.source_update_time = #{req.sourceUpdateTime}
            </if>
            <if test="req.snapshotTime != null">
                AND t.snapshot_time = #{req.snapshotTime}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.aps.controller.admin.projectioninv.vo.ProjectionInvRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.aps.controller.admin.projectioninv.vo.ProjectionInvRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>