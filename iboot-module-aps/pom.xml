<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.iboot</groupId>
        <artifactId>iboot</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>iboot-module-aps</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        aps 包下，高级计划排程（Advanced Planning and Scheduling）。
        例如说：生产计划、排程、产能、物料需求等等
    </description>

    <dependencies>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-mdm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-wms</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-mes</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 显式依赖 infra：编码规则 CodeRuleApi 与 WebSocket 推送 WebSocketSenderApi 都在这里，
             之前靠 mdm 传递才编得过，传递依赖一断就编译失败 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- 排程求解相关：Timefold Solver Community Edition（Apache-2.0）。
             版本由 iboot-dependencies 的 timefold-solver-bom 统一管理，不引 spring-boot-starter：
             它会全局扫描 @PlanningSolution 并只支持 yaml 配置，挡住按策略动态构建求解配置 -->
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
