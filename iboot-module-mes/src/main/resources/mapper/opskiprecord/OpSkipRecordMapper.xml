<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.opskiprecord.OpSkipRecordMapper">

    <!-- 模块内关联走 JOIN；人员昵称由 Service 调 system 门面补全 -->
    <sql id="selectColumns">
        t.*
        , op_task.task_no AS op_task_no
        , op_task.op_name AS op_name
        , op_task.work_order_no AS work_order_no
    </sql>

    <sql id="joinTables">
        FROM mes_op_skip_record t
        LEFT JOIN mes_op_task op_task ON op_task.id = t.op_task_id AND op_task.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.opTaskId != null">
                AND t.op_task_id = #{req.opTaskId}
            </if>
            <if test="req.skipReasonType != null and req.skipReasonType != ''">
                AND t.skip_reason_type = #{req.skipReasonType}
            </if>
            <if test="req.operatorId != null">
                AND t.operator_id = #{req.operatorId}
            </if>
            <if test="req.approvedBy != null">
                AND t.approved_by = #{req.approvedBy}
            </if>
            <if test="req.approveStatus != null and req.approveStatus != ''">
                AND t.approve_status = #{req.approveStatus}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.skipTime != null and req.skipTime.length == 2">
                AND t.skip_time BETWEEN #{req.skipTime[0]} AND #{req.skipTime[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.mes.controller.admin.opskiprecord.vo.OpSkipRecordRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.mes.controller.admin.opskiprecord.vo.OpSkipRecordRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
