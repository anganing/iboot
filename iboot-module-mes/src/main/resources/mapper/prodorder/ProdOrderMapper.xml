<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.prodorder.ProdOrderMapper">

    <!-- 模块内关联走 JOIN；工厂、车间、项目名称由 Service 调 mdm 门面补全，禁止跨库 JOIN -->
    <sql id="selectColumns">
        t.*
        , prod_demand.demand_no AS demand_no
    </sql>

    <sql id="joinTables">
        FROM mes_prod_order t
        LEFT JOIN mes_prod_demand prod_demand ON prod_demand.id = t.demand_id AND prod_demand.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.orderNo != null and req.orderNo != ''">
                AND t.order_no LIKE CONCAT('%', #{req.orderNo}, '%')
            </if>
            <if test="req.demandId != null">
                AND t.demand_id = #{req.demandId}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code LIKE CONCAT('%', #{req.matCode}, '%')
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.kitStatus != null and req.kitStatus != ''">
                AND t.kit_status = #{req.kitStatus}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.dueDate != null and req.dueDate.length == 2">
                AND t.due_date BETWEEN #{req.dueDate[0]} AND #{req.dueDate[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.prodorder.vo.ProdOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.priority DESC, t.due_date ASC, t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.prodorder.vo.ProdOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
