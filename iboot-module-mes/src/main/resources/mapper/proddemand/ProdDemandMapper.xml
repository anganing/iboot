<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.proddemand.ProdDemandMapper">

    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM mes_prod_demand t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.demandNo != null and req.demandNo != ''">
                AND t.demand_no = #{req.demandNo}
            </if>
            <if test="req.sourceType != null and req.sourceType != ''">
                AND t.source_type = #{req.sourceType}
            </if>
            <if test="req.sourceNo != null and req.sourceNo != ''">
                AND t.source_no = #{req.sourceNo}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.projectTaskId != null">
                AND t.project_task_id = #{req.projectTaskId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.matSpec != null and req.matSpec != ''">
                AND t.mat_spec = #{req.matSpec}
            </if>
            <if test="req.qty != null">
                AND t.qty = #{req.qty}
            </if>
            <if test="req.uomId != null">
                AND t.uom_id = #{req.uomId}
            </if>
            <if test="req.uomCode != null and req.uomCode != ''">
                AND t.uom_code = #{req.uomCode}
            </if>
            <if test="req.dueDate != null">
                AND t.due_date = #{req.dueDate}
            </if>
            <if test="req.priority != null">
                AND t.priority = #{req.priority}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.idempotencyKey != null and req.idempotencyKey != ''">
                AND t.idempotency_key = #{req.idempotencyKey}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.proddemand.vo.ProdDemandRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.proddemand.vo.ProdDemandRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>