<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.materialreq.MaterialReqMapper">

    <!-- 模块内关联走 JOIN；仓库、项目名称由 Service 调 wms 与 mdm 门面补全 -->
    <sql id="selectColumns">
        t.*
        , work_order.work_order_no AS work_order_no
        , op_task.task_no AS op_task_no
    </sql>

    <sql id="joinTables">
        FROM mes_material_req t
        LEFT JOIN mes_work_order work_order ON work_order.id = t.work_order_id AND work_order.deleted = 0
        LEFT JOIN mes_op_task op_task ON op_task.id = t.op_task_id AND op_task.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.reqNo != null and req.reqNo != ''">
                AND t.req_no LIKE CONCAT('%', #{req.reqNo}, '%')
            </if>
            <if test="req.prodOrderId != null">
                AND t.prod_order_id = #{req.prodOrderId}
            </if>
            <if test="req.prodOrderNo != null and req.prodOrderNo != ''">
                AND t.prod_order_no LIKE CONCAT('%', #{req.prodOrderNo}, '%')
            </if>
            <if test="req.workOrderId != null">
                AND t.work_order_id = #{req.workOrderId}
            </if>
            <if test="req.reqType != null and req.reqType != ''">
                AND t.req_type = #{req.reqType}
            </if>
            <if test="req.invOrgId != null">
                AND t.inv_org_id = #{req.invOrgId}
            </if>
            <if test="req.whId != null">
                AND t.wh_id = #{req.whId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.wmsBizNo != null and req.wmsBizNo != ''">
                AND t.wms_biz_no LIKE CONCAT('%', #{req.wmsBizNo}, '%')
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.mes.controller.admin.materialreq.vo.MaterialReqRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.mes.controller.admin.materialreq.vo.MaterialReqRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
