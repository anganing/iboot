<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.optask.OpTaskMapper">

    <!-- 模块内关联走 JOIN，带出生产工单号；资源名称由 Service 调 mdm 门面补全 -->
    <sql id="selectColumns">
        t.*
        , work_order.prod_order_no AS prod_order_no
    </sql>

    <sql id="joinTables">
        FROM mes_op_task t
        LEFT JOIN mes_work_order work_order ON work_order.id = t.work_order_id AND work_order.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.taskNo != null and req.taskNo != ''">
                AND t.task_no LIKE CONCAT('%', #{req.taskNo}, '%')
            </if>
            <if test="req.workOrderId != null">
                AND t.work_order_id = #{req.workOrderId}
            </if>
            <if test="req.workOrderNo != null and req.workOrderNo != ''">
                AND t.work_order_no LIKE CONCAT('%', #{req.workOrderNo}, '%')
            </if>
            <if test="req.prodOrderNo != null and req.prodOrderNo != ''">
                AND work_order.prod_order_no LIKE CONCAT('%', #{req.prodOrderNo}, '%')
            </if>
            <if test="req.opId != null">
                AND t.op_id = #{req.opId}
            </if>
            <if test="req.opCode != null and req.opCode != ''">
                AND t.op_code LIKE CONCAT('%', #{req.opCode}, '%')
            </if>
            <if test="req.opName != null and req.opName != ''">
                AND t.op_name LIKE CONCAT('%', #{req.opName}, '%')
            </if>
            <if test="req.resId != null">
                AND t.res_id = #{req.resId}
            </if>
            <if test="req.keyFlag != null">
                AND t.key_flag = #{req.keyFlag}
            </if>
            <if test="req.qcMode != null and req.qcMode != ''">
                AND t.qc_mode = #{req.qcMode}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.plannedStartTime != null and req.plannedStartTime.length == 2">
                AND t.planned_start_time BETWEEN #{req.plannedStartTime[0]} AND #{req.plannedStartTime[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.optask.vo.OpTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.work_order_id DESC, t.seq ASC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.optask.vo.OpTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
