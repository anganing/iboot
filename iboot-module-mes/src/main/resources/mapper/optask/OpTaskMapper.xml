<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.optask.OpTaskMapper">

    <sql id="selectColumns">
        t.*
        , work_order.work_order_no AS work_order_work_order_no
    </sql>

    <sql id="joinTables">
        FROM mes_op_task t
        LEFT JOIN mes_work_order work_order ON work_order.id = t.work_order_id AND work_order.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.taskNo != null and req.taskNo != ''">
                AND t.task_no = #{req.taskNo}
            </if>
            <if test="req.workOrderNo != null and req.workOrderNo != ''">
                AND t.work_order_no = #{req.workOrderNo}
            </if>
            <if test="req.routeOpId != null">
                AND t.route_op_id = #{req.routeOpId}
            </if>
            <if test="req.opId != null">
                AND t.op_id = #{req.opId}
            </if>
            <if test="req.opCode != null and req.opCode != ''">
                AND t.op_code = #{req.opCode}
            </if>
            <if test="req.opName != null and req.opName != ''">
                AND t.op_name LIKE CONCAT('%', #{req.opName}, '%')
            </if>
            <if test="req.seq != null">
                AND t.seq = #{req.seq}
            </if>
            <if test="req.parallelGroup != null and req.parallelGroup != ''">
                AND t.parallel_group = #{req.parallelGroup}
            </if>
            <if test="req.prevTaskId != null">
                AND t.prev_task_id = #{req.prevTaskId}
            </if>
            <if test="req.nextTaskId != null">
                AND t.next_task_id = #{req.nextTaskId}
            </if>
            <if test="req.execMode != null and req.execMode != ''">
                AND t.exec_mode = #{req.execMode}
            </if>
            <if test="req.qcMode != null and req.qcMode != ''">
                AND t.qc_mode = #{req.qcMode}
            </if>
            <if test="req.skipPolicy != null and req.skipPolicy != ''">
                AND t.skip_policy = #{req.skipPolicy}
            </if>
            <if test="req.keyFlag != null">
                AND t.key_flag = #{req.keyFlag}
            </if>
            <if test="req.plannedQty != null">
                AND t.planned_qty = #{req.plannedQty}
            </if>
            <if test="req.completedQty != null">
                AND t.completed_qty = #{req.completedQty}
            </if>
            <if test="req.scrapQty != null">
                AND t.scrap_qty = #{req.scrapQty}
            </if>
            <if test="req.resId != null">
                AND t.res_id = #{req.resId}
            </if>
            <if test="req.plannedStartTime != null">
                AND t.planned_start_time = #{req.plannedStartTime}
            </if>
            <if test="req.plannedEndTime != null">
                AND t.planned_end_time = #{req.plannedEndTime}
            </if>
            <if test="req.actualStartTime != null">
                AND t.actual_start_time = #{req.actualStartTime}
            </if>
            <if test="req.actualEndTime != null">
                AND t.actual_end_time = #{req.actualEndTime}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.version != null">
                AND t.version = #{req.version}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.optask.vo.OpTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.optask.vo.OpTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>