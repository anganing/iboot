<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.qcitem.QcItemMapper">

    <!-- 检验方案在同一模块内，直接 JOIN 出编码与名称 -->
    <sql id="selectColumns">
        t.*
        , qc_plan.code AS plan_code
        , qc_plan.name AS plan_name
    </sql>

    <sql id="joinTables">
        FROM mes_qc_item t
        LEFT JOIN mes_qc_plan qc_plan ON qc_plan.id = t.plan_id AND qc_plan.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.planId != null">
                AND t.plan_id = #{req.planId}
            </if>
            <if test="req.itemCode != null and req.itemCode != ''">
                AND t.item_code LIKE CONCAT('%', #{req.itemCode}, '%')
            </if>
            <if test="req.itemName != null and req.itemName != ''">
                AND t.item_name LIKE CONCAT('%', #{req.itemName}, '%')
            </if>
            <if test="req.itemType != null and req.itemType != ''">
                AND t.item_type = #{req.itemType}
            </if>
            <if test="req.requiredFlag != null">
                AND t.required_flag = #{req.requiredFlag}
            </if>
            <if test="req.status != null">
                AND t.status = #{req.status}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.qcitem.vo.QcItemRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.plan_id DESC, t.sort_no ASC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.qcitem.vo.QcItemRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
