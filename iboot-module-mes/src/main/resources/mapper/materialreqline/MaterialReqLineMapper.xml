<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.materialreqline.MaterialReqLineMapper">

    <!-- 物料、单位、批次快照写入时已落库，这里不需要再回查其他表 -->
    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM mes_material_req_line t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            AND t.req_id = #{req.reqId}
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no LIKE CONCAT('%', #{req.lotNo}, '%')
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.mes.controller.admin.materialreq.vo.MaterialReqLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.line_no ASC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.mes.controller.admin.materialreq.vo.MaterialReqLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
