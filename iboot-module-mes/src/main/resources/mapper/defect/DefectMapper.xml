<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.defect.DefectMapper">

    <sql id="selectColumns">
        t.*
        , qc_task.task_no AS task_task_no
    </sql>

    <sql id="joinTables">
        FROM mes_defect t
        LEFT JOIN mes_qc_task qc_task ON qc_task.id = t.task_id AND qc_task.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.resultId != null">
                AND t.result_id = #{req.resultId}
            </if>
            <if test="req.defectCode != null and req.defectCode != ''">
                AND t.defect_code = #{req.defectCode}
            </if>
            <if test="req.defectName != null and req.defectName != ''">
                AND t.defect_name LIKE CONCAT('%', #{req.defectName}, '%')
            </if>
            <if test="req.defectLevel != null and req.defectLevel != ''">
                AND t.defect_level = #{req.defectLevel}
            </if>
            <if test="req.qty != null">
                AND t.qty = #{req.qty}
            </if>
            <if test="req.description != null and req.description != ''">
                AND t.description = #{req.description}
            </if>
            <if test="req.location != null and req.location != ''">
                AND t.location = #{req.location}
            </if>
            <if test="req.attachmentUrls != null and req.attachmentUrls != ''">
                AND t.attachment_urls = #{req.attachmentUrls}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.defect.vo.DefectRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.defect.vo.DefectRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>