<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.qcresult.QcResultMapper">

    <!-- 质检任务在同一模块内走 JOIN；检验员昵称由 Service 调 system 门面补全 -->
    <sql id="selectColumns">
        t.*
        , qc_task.task_no AS task_no
    </sql>

    <sql id="joinTables">
        FROM mes_qc_result t
        LEFT JOIN mes_qc_task qc_task ON qc_task.id = t.task_id AND qc_task.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.taskId != null">
                AND t.task_id = #{req.taskId}
            </if>
            <if test="req.itemId != null">
                AND t.item_id = #{req.itemId}
            </if>
            <if test="req.itemCode != null and req.itemCode != ''">
                AND t.item_code LIKE CONCAT('%', #{req.itemCode}, '%')
            </if>
            <if test="req.itemName != null and req.itemName != ''">
                AND t.item_name LIKE CONCAT('%', #{req.itemName}, '%')
            </if>
            <if test="req.passFlag != null">
                AND t.pass_flag = #{req.passFlag}
            </if>
            <if test="req.inspectorId != null">
                AND t.inspector_id = #{req.inspectorId}
            </if>
            <if test="req.conclusion != null and req.conclusion != ''">
                AND t.conclusion = #{req.conclusion}
            </if>
            <if test="req.inspectTime != null and req.inspectTime.length == 2">
                AND t.inspect_time BETWEEN #{req.inspectTime[0]} AND #{req.inspectTime[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.qcresult.vo.QcResultRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.task_id DESC, t.item_id ASC, t.sample_no ASC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.qcresult.vo.QcResultRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
