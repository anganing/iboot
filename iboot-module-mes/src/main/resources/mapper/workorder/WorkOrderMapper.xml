<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.workorder.WorkOrderMapper">

    <sql id="selectColumns">
        t.*
        , prod_order.order_no AS prod_order_order_no
    </sql>

    <sql id="joinTables">
        FROM mes_work_order t
        LEFT JOIN mes_prod_order prod_order ON prod_order.id = t.prod_order_id AND prod_order.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.workOrderNo != null and req.workOrderNo != ''">
                AND t.work_order_no = #{req.workOrderNo}
            </if>
            <if test="req.prodOrderNo != null and req.prodOrderNo != ''">
                AND t.prod_order_no = #{req.prodOrderNo}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.wcId != null">
                AND t.wc_id = #{req.wcId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.projectTaskId != null">
                AND t.project_task_id = #{req.projectTaskId}
            </if>
            <if test="req.plannedQty != null">
                AND t.planned_qty = #{req.plannedQty}
            </if>
            <if test="req.completedQty != null">
                AND t.completed_qty = #{req.completedQty}
            </if>
            <if test="req.plannedStartTime != null">
                AND t.planned_start_time = #{req.plannedStartTime}
            </if>
            <if test="req.plannedEndTime != null">
                AND t.planned_end_time = #{req.plannedEndTime}
            </if>
            <if test="req.actualStartTime != null">
                AND t.actual_start_time = #{req.actualStartTime}
            </if>
            <if test="req.actualEndTime != null">
                AND t.actual_end_time = #{req.actualEndTime}
            </if>
            <if test="req.kitStatus != null and req.kitStatus != ''">
                AND t.kit_status = #{req.kitStatus}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.version != null">
                AND t.version = #{req.version}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.workorder.vo.WorkOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.workorder.vo.WorkOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>