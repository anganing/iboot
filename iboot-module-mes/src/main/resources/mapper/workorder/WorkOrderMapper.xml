<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mes.dal.mysql.workorder.WorkOrderMapper">

    <!-- 模块内关联走 JOIN，带出生产工单上的物料可读字段；组织与项目名称由 Service 调 mdm 门面补全 -->
    <sql id="selectColumns">
        t.*
        , prod_order.mat_code AS mat_code
        , prod_order.mat_name AS mat_name
    </sql>

    <sql id="joinTables">
        FROM mes_work_order t
        LEFT JOIN mes_prod_order prod_order ON prod_order.id = t.prod_order_id AND prod_order.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.workOrderNo != null and req.workOrderNo != ''">
                AND t.work_order_no LIKE CONCAT('%', #{req.workOrderNo}, '%')
            </if>
            <if test="req.prodOrderId != null">
                AND t.prod_order_id = #{req.prodOrderId}
            </if>
            <if test="req.prodOrderNo != null and req.prodOrderNo != ''">
                AND t.prod_order_no LIKE CONCAT('%', #{req.prodOrderNo}, '%')
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.workshopId != null">
                AND t.workshop_id = #{req.workshopId}
            </if>
            <if test="req.wcId != null">
                AND t.wc_id = #{req.wcId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.kitStatus != null and req.kitStatus != ''">
                AND t.kit_status = #{req.kitStatus}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.plannedStartTime != null and req.plannedStartTime.length == 2">
                AND t.planned_start_time BETWEEN #{req.plannedStartTime[0]} AND #{req.plannedStartTime[1]}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mes.controller.admin.workorder.vo.WorkOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mes.controller.admin.workorder.vo.WorkOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
