<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.iboot</groupId>
        <artifactId>iboot</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>iboot-module-wms</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        wms 包下，仓储管理系统（Warehouse Management System）。
        例如说：入库、出库、库存、盘点、库位等等
    </description>

    <dependencies>
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 依赖 MDM 主数据模块，用于跨模块 API 门面取主数据 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-module-mdm</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.iboot</groupId>
            <artifactId>iboot-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
