<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.transferorder.TransferOrderMapper">

    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM wms_transfer_order t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.transferNo != null and req.transferNo != ''">
                AND t.transfer_no = #{req.transferNo}
            </if>
            <if test="req.transferType != null and req.transferType != ''">
                AND t.transfer_type = #{req.transferType}
            </if>
            <if test="req.sourceType != null and req.sourceType != ''">
                AND t.source_type = #{req.sourceType}
            </if>
            <if test="req.sourceBizNo != null and req.sourceBizNo != ''">
                AND t.source_biz_no = #{req.sourceBizNo}
            </if>
            <if test="req.fromInvOrgId != null">
                AND t.from_inv_org_id = #{req.fromInvOrgId}
            </if>
            <if test="req.toInvOrgId != null">
                AND t.to_inv_org_id = #{req.toInvOrgId}
            </if>
            <if test="req.fromWhId != null">
                AND t.from_wh_id = #{req.fromWhId}
            </if>
            <if test="req.toWhId != null">
                AND t.to_wh_id = #{req.toWhId}
            </if>
            <if test="req.fromProjectId != null">
                AND t.from_project_id = #{req.fromProjectId}
            </if>
            <if test="req.toProjectId != null">
                AND t.to_project_id = #{req.toProjectId}
            </if>
            <if test="req.hookMode != null and req.hookMode != ''">
                AND t.hook_mode = #{req.hookMode}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.idempotencyKey != null and req.idempotencyKey != ''">
                AND t.idempotency_key = #{req.idempotencyKey}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.transferorder.vo.TransferOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.transferorder.vo.TransferOrderRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>