<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.inventory.WmsInvBalanceMapper">

    <sql id="selectColumns">
        t.*
        , wh.name AS wh_name
    </sql>

    <sql id="joinTables">
        FROM wms_inv_balance t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.locId != null">
                AND t.loc_id = #{req.locId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.projectId != null">
                AND t.project_id = #{req.projectId}
            </if>
            <if test="req.stockScope != null and req.stockScope != ''">
                AND t.stock_scope = #{req.stockScope}
            </if>
            <if test="req.qualityStatus != null and req.qualityStatus != ''">
                AND t.quality_status = #{req.qualityStatus}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.invbalance.vo.InvBalanceRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.invbalance.vo.InvBalanceRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>