<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.arrival.ArrivalMapper">

    <sql id="selectColumns">
        t.*
        , wh.code AS wh_code
        , wh.name AS wh_name
    </sql>

    <sql id="joinTables">
        FROM wms_arrival t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.arrivalNo != null and req.arrivalNo != ''">
                AND t.arrival_no = #{req.arrivalNo}
            </if>
            <if test="req.sourceType != null and req.sourceType != ''">
                AND t.source_type = #{req.sourceType}
            </if>
            <if test="req.sourceNo != null and req.sourceNo != ''">
                AND t.source_no = #{req.sourceNo}
            </if>
            <if test="req.supplierId != null">
                AND t.supplier_id = #{req.supplierId}
            </if>
            <if test="req.supplierCode != null and req.supplierCode != ''">
                AND t.supplier_code = #{req.supplierCode}
            </if>
            <if test="req.supplierName != null and req.supplierName != ''">
                AND t.supplier_name LIKE CONCAT('%', #{req.supplierName}, '%')
            </if>
            <if test="req.invOrgId != null">
                AND t.inv_org_id = #{req.invOrgId}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.expectDate != null">
                AND t.expect_date = #{req.expectDate}
            </if>
            <if test="req.arrivalTime != null">
                AND t.arrival_time = #{req.arrivalTime}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.arrival.vo.ArrivalRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.arrival.vo.ArrivalRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>