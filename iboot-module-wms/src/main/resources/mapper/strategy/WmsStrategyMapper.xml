<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.strategy.WmsStrategyMapper">

    <sql id="selectColumns">
        t.*
        , wh.code AS wh_code
        , wh.name AS wh_name
    </sql>

    <sql id="joinTables">
        FROM wms_strategy t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.code != null and req.code != ''">
                AND t.code = #{req.code}
            </if>
            <if test="req.name != null and req.name != ''">
                AND t.name LIKE CONCAT('%', #{req.name}, '%')
            </if>
            <if test="req.strategyType != null and req.strategyType != ''">
                AND t.strategy_type = #{req.strategyType}
            </if>
            <if test="req.versionNo != null and req.versionNo != ''">
                AND t.version_no = #{req.versionNo}
            </if>
            <if test="req.configJson != null and req.configJson != ''">
                AND t.config_json = #{req.configJson}
            </if>
            <if test="req.priority != null">
                AND t.priority = #{req.priority}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.strategy.vo.StrategyRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.strategy.vo.StrategyRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>