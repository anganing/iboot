<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.loc.LocMapper">

    <sql id="selectColumns">
        t.*
        , wh.code AS wh_code
        , wh.name AS wh_name
        , zone.code AS zone_code
        , zone.name AS zone_name
    </sql>

    <sql id="joinTables">
        FROM wms_loc t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
        LEFT JOIN wms_zone zone ON zone.id = t.zone_id AND zone.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.code != null and req.code != ''">
                AND t.code = #{req.code}
            </if>
            <if test="req.locType != null and req.locType != ''">
                AND t.loc_type = #{req.locType}
            </if>
            <if test="req.aisleNo != null and req.aisleNo != ''">
                AND t.aisle_no = #{req.aisleNo}
            </if>
            <if test="req.rowNo != null and req.rowNo != ''">
                AND t.row_no = #{req.rowNo}
            </if>
            <if test="req.colNo != null and req.colNo != ''">
                AND t.col_no = #{req.colNo}
            </if>
            <if test="req.levelNo != null and req.levelNo != ''">
                AND t.level_no = #{req.levelNo}
            </if>
            <if test="req.depthNo != null">
                AND t.depth_no = #{req.depthNo}
            </if>
            <if test="req.maxLength != null">
                AND t.max_length = #{req.maxLength}
            </if>
            <if test="req.maxWidth != null">
                AND t.max_width = #{req.maxWidth}
            </if>
            <if test="req.maxHeight != null">
                AND t.max_height = #{req.maxHeight}
            </if>
            <if test="req.maxWeight != null">
                AND t.max_weight = #{req.maxWeight}
            </if>
            <if test="req.maxVolume != null">
                AND t.max_volume = #{req.maxVolume}
            </if>
            <if test="req.maxContainerQty != null">
                AND t.max_container_qty = #{req.maxContainerQty}
            </if>
            <if test="req.dimensionCheckMode != null and req.dimensionCheckMode != ''">
                AND t.dimension_check_mode = #{req.dimensionCheckMode}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.loc.vo.LocRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.loc.vo.LocRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>