<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.invtxn.InvTxnMapper">

    <sql id="selectColumns">
        t.*
        , wh.code AS wh_code
        , wh.name AS wh_name
    </sql>

    <sql id="joinTables">
        FROM wms_inv_txn t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.txnNo != null and req.txnNo != ''">
                AND t.txn_no = #{req.txnNo}
            </if>
            <if test="req.txnType != null and req.txnType != ''">
                AND t.txn_type = #{req.txnType}
            </if>
            <if test="req.bizType != null and req.bizType != ''">
                AND t.biz_type = #{req.bizType}
            </if>
            <if test="req.bizNo != null and req.bizNo != ''">
                AND t.biz_no = #{req.bizNo}
            </if>
            <if test="req.bizLineNo != null and req.bizLineNo != ''">
                AND t.biz_line_no = #{req.bizLineNo}
            </if>
            <if test="req.ioType != null and req.ioType != ''">
                AND t.io_type = #{req.ioType}
            </if>
            <if test="req.invOrgId != null">
                AND t.inv_org_id = #{req.invOrgId}
            </if>
            <if test="req.plantId != null">
                AND t.plant_id = #{req.plantId}
            </if>
            <if test="req.fromLocId != null">
                AND t.from_loc_id = #{req.fromLocId}
            </if>
            <if test="req.toLocId != null">
                AND t.to_loc_id = #{req.toLocId}
            </if>
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.batchId != null">
                AND t.batch_id = #{req.batchId}
            </if>
            <if test="req.containerId != null">
                AND t.container_id = #{req.containerId}
            </if>
            <if test="req.uomId != null">
                AND t.uom_id = #{req.uomId}
            </if>
            <if test="req.qty != null">
                AND t.qty = #{req.qty}
            </if>
            <if test="req.beforeQty != null">
                AND t.before_qty = #{req.beforeQty}
            </if>
            <if test="req.afterQty != null">
                AND t.after_qty = #{req.afterQty}
            </if>
            <if test="req.qualityStatusFrom != null and req.qualityStatusFrom != ''">
                AND t.quality_status_from = #{req.qualityStatusFrom}
            </if>
            <if test="req.qualityStatusTo != null and req.qualityStatusTo != ''">
                AND t.quality_status_to = #{req.qualityStatusTo}
            </if>
            <if test="req.projectIdFrom != null">
                AND t.project_id_from = #{req.projectIdFrom}
            </if>
            <if test="req.projectTaskIdFrom != null">
                AND t.project_task_id_from = #{req.projectTaskIdFrom}
            </if>
            <if test="req.projectIdTo != null">
                AND t.project_id_to = #{req.projectIdTo}
            </if>
            <if test="req.projectTaskIdTo != null">
                AND t.project_task_id_to = #{req.projectTaskIdTo}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.uomCode != null and req.uomCode != ''">
                AND t.uom_code = #{req.uomCode}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.fromLocCode != null and req.fromLocCode != ''">
                AND t.from_loc_code = #{req.fromLocCode}
            </if>
            <if test="req.toLocCode != null and req.toLocCode != ''">
                AND t.to_loc_code = #{req.toLocCode}
            </if>
            <if test="req.idempotencyKey != null and req.idempotencyKey != ''">
                AND t.idempotency_key = #{req.idempotencyKey}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.invtxn.vo.InvTxnRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.invtxn.vo.InvTxnRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>