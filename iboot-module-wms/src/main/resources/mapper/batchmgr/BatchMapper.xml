<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.batchmgr.BatchMapper">

    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM wms_batch t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.matCode != null and req.matCode != ''">
                AND t.mat_code = #{req.matCode}
            </if>
            <if test="req.matName != null and req.matName != ''">
                AND t.mat_name LIKE CONCAT('%', #{req.matName}, '%')
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.snNo != null and req.snNo != ''">
                AND t.sn_no = #{req.snNo}
            </if>
            <if test="req.supplierId != null">
                AND t.supplier_id = #{req.supplierId}
            </if>
            <if test="req.supplierCode != null and req.supplierCode != ''">
                AND t.supplier_code = #{req.supplierCode}
            </if>
            <if test="req.supplierLotNo != null and req.supplierLotNo != ''">
                AND t.supplier_lot_no = #{req.supplierLotNo}
            </if>
            <if test="req.furnaceLotNo != null and req.furnaceLotNo != ''">
                AND t.furnace_lot_no = #{req.furnaceLotNo}
            </if>
            <if test="req.produceDate != null">
                AND t.produce_date = #{req.produceDate}
            </if>
            <if test="req.expiryDate != null">
                AND t.expiry_date = #{req.expiryDate}
            </if>
            <if test="req.status != null">
                AND t.status = #{req.status}
            </if>
            <if test="req.remark != null and req.remark != ''">
                AND t.remark = #{req.remark}
            </if>
            <if test="req.createTime != null">
                AND t.create_time = #{req.createTime}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.batchmgr.vo.BatchRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.batchmgr.vo.BatchRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>