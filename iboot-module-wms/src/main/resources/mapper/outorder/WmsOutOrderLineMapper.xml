<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.outorder.WmsOutOrderLineMapper">

    <!-- 来源库位编码已落快照，目标库位与容器需要 JOIN 补出可读值 -->
    <sql id="selectColumns">
        t.*
        , to_loc.code AS to_loc_code
        , container.container_no AS container_no
    </sql>

    <sql id="joinTables">
        FROM wms_out_order_line t
        LEFT JOIN wms_loc to_loc ON to_loc.id = t.to_loc_id AND to_loc.deleted = 0
        LEFT JOIN wms_container container ON container.id = t.container_id AND container.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            AND t.order_id = #{req.orderId}
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.wms.controller.admin.outordermgr.vo.OutOrderLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.line_no ASC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.wms.controller.admin.outordermgr.vo.OutOrderLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
