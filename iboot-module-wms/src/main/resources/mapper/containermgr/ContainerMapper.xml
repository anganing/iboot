<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.containermgr.ContainerMapper">

    <sql id="selectColumns">
        t.*
        , wh.code AS wh_code
        , wh.name AS wh_name
        , ct.code AS type_code
        , ct.name AS type_name
        , loc.code AS loc_code
    </sql>

    <sql id="joinTables">
        FROM wms_container t
        LEFT JOIN wms_wh wh ON wh.id = t.wh_id AND wh.deleted = 0
        LEFT JOIN wms_container_type ct ON ct.id = t.type_id AND ct.deleted = 0
        LEFT JOIN wms_loc loc ON loc.id = t.loc_id AND loc.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            <if test="req.containerNo != null and req.containerNo != ''">
                AND t.container_no = #{req.containerNo}
            </if>
            <if test="req.typeId != null">
                AND t.type_id = #{req.typeId}
            </if>
            <if test="req.locId != null">
                AND t.loc_id = #{req.locId}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND t.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.wms.controller.admin.containermgr.vo.ContainerRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.wms.controller.admin.containermgr.vo.ContainerRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
