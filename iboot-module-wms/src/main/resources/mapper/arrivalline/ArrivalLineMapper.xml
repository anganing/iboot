<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.wms.dal.mysql.arrivalline.ArrivalLineMapper">

    <!-- 物料、单位快照已落库在明细行上，这里只补全前端需要的可读字段 -->
    <sql id="selectColumns">
        t.*
    </sql>

    <sql id="joinTables">
        FROM wms_arrival_line t
    </sql>

    <sql id="whereConditions">
        <where>
            t.deleted = 0
            AND t.arrival_id = #{req.arrivalId}
            <if test="req.matId != null">
                AND t.mat_id = #{req.matId}
            </if>
            <if test="req.lotNo != null and req.lotNo != ''">
                AND t.lot_no = #{req.lotNo}
            </if>
            <if test="req.status != null and req.status != ''">
                AND t.status = #{req.status}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage"
            resultType="com.iboot.pf.module.wms.controller.admin.arrival.vo.ArrivalLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY t.line_no ASC
    </select>

    <select id="selectJoinById"
            resultType="com.iboot.pf.module.wms.controller.admin.arrival.vo.ArrivalLineRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE t.deleted = 0 AND t.id = #{id}
    </select>

</mapper>
