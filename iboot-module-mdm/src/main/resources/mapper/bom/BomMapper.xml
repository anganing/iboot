<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.bom.BomMapper">

    <sql id="selectColumns">
        b.*,
        m.code AS mat_code,
        m.name AS mat_name
    </sql>

    <sql id="joinTables">
        FROM mdm_bom b
        LEFT JOIN mdm_mat m ON m.id = b.mat_id AND m.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            b.deleted = 0
            <if test="req.matId != null">AND b.mat_id = #{req.matId}</if>
            <if test="req.version != null and req.version != ''">AND b.version = #{req.version}</if>
            <if test="req.status != null and req.status != ''">AND b.status = #{req.status}</if>
            <if test="req.effectiveDate != null and req.effectiveDate.length == 2">
                AND b.effective_date BETWEEN #{req.effectiveDate[0]} AND #{req.effectiveDate[1]}
            </if>
            <if test="req.expiryDate != null and req.expiryDate.length == 2">
                AND b.expiry_date BETWEEN #{req.expiryDate[0]} AND #{req.expiryDate[1]}
            </if>
            <if test="req.remark != null and req.remark != ''">AND b.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND b.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.bom.vo.BomRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY b.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.bom.vo.BomRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE b.deleted = 0 AND b.id = #{id}
    </select>

</mapper>
