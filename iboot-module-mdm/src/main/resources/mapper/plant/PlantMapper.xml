<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.plant.PlantMapper">

    <sql id="selectColumns">
        p.*,
        io.code AS inv_org_code,
        io.name AS inv_org_name
    </sql>

    <sql id="joinTables">
        FROM mdm_plant p
        LEFT JOIN mdm_inv_org io ON io.id = p.inv_org_id AND io.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            p.deleted = 0
            <if test="req.invOrgId != null">AND p.inv_org_id = #{req.invOrgId}</if>
            <if test="req.code != null and req.code != ''">AND p.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND p.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.address != null and req.address != ''">AND p.address = #{req.address}</if>
            <if test="req.status != null">AND p.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND p.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND p.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.plant.vo.PlantRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY p.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.plant.vo.PlantRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE p.deleted = 0 AND p.id = #{id}
    </select>

</mapper>
