<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.rescalendar.ResCalendarMapper">

    <sql id="selectColumns">
        rc.*,
        r.code AS res_code,
        r.name AS res_name,
        s.code AS shift_code,
        s.name AS shift_name
    </sql>

    <sql id="joinTables">
        FROM mdm_res_calendar rc
        LEFT JOIN mdm_res r ON r.id = rc.res_id AND r.deleted = 0
        LEFT JOIN mdm_shift s ON s.id = rc.shift_id AND s.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            rc.deleted = 0
            <if test="req.resId != null">AND rc.res_id = #{req.resId}</if>
            <if test="req.workDate != null and req.workDate.length == 2">
                AND rc.work_date BETWEEN #{req.workDate[0]} AND #{req.workDate[1]}
            </if>
            <if test="req.shiftId != null">AND rc.shift_id = #{req.shiftId}</if>
            <if test="req.availableMinutes != null">AND rc.available_minutes = #{req.availableMinutes}</if>
            <if test="req.remark != null and req.remark != ''">AND rc.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND rc.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.rescalendar.vo.ResCalendarRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY rc.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.rescalendar.vo.ResCalendarRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE rc.deleted = 0 AND rc.id = #{id}
    </select>

</mapper>
