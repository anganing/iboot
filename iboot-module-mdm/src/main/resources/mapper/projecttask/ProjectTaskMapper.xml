<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.projecttask.ProjectTaskMapper">

    <sql id="selectColumns">
        pt.*,
        pr.code AS project_code,
        pr.name AS project_name
    </sql>

    <sql id="joinTables">
        FROM mdm_project_task pt
        LEFT JOIN mdm_project pr ON pr.id = pt.project_id AND pr.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            pt.deleted = 0
            <if test="req.projectId != null">AND pt.project_id = #{req.projectId}</if>
            <if test="req.code != null and req.code != ''">AND pt.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND pt.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.status != null">AND pt.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND pt.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND pt.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.projecttask.vo.ProjectTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY pt.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.projecttask.vo.ProjectTaskRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE pt.deleted = 0 AND pt.id = #{id}
    </select>

</mapper>
