<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.matalt.MatAltMapper">

    <sql id="selectColumns">
        ma.*,
        bm.code AS mat_code,
        bm.name AS mat_name,
        am.code AS alt_mat_code,
        am.name AS alt_mat_name
    </sql>

    <sql id="joinTables">
        FROM mdm_mat_alt ma
        LEFT JOIN mdm_mat bm ON bm.id = ma.mat_id AND bm.deleted = 0
        LEFT JOIN mdm_mat am ON am.id = ma.alt_mat_id AND am.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            ma.deleted = 0
            <if test="req.matId != null">AND ma.mat_id = #{req.matId}</if>
            <if test="req.altMatId != null">AND ma.alt_mat_id = #{req.altMatId}</if>
            <if test="req.priority != null">AND ma.priority = #{req.priority}</if>
            <if test="req.remark != null and req.remark != ''">AND ma.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND ma.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.matalt.vo.MatAltRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY ma.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.matalt.vo.MatAltRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE ma.deleted = 0 AND ma.id = #{id}
    </select>

</mapper>
