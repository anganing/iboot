<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.matcat.MatCatMapper">

    <sql id="selectColumns">
        mc.*,
        pc.code AS parent_code,
        pc.name AS parent_name
    </sql>

    <sql id="joinTables">
        FROM mdm_mat_cat mc
        LEFT JOIN mdm_mat_cat pc ON pc.id = mc.parent_id AND pc.deleted = 0
    </sql>

    <select id="selectJoinList" resultType="com.iboot.pf.module.mdm.controller.admin.matcat.vo.MatCatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <where>
            mc.deleted = 0
            <if test="req.parentId != null">AND mc.parent_id = #{req.parentId}</if>
            <if test="req.code != null and req.code != ''">AND mc.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND mc.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.status != null">AND mc.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND mc.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND mc.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
        ORDER BY mc.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.matcat.vo.MatCatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE mc.deleted = 0 AND mc.id = #{id}
    </select>

</mapper>
