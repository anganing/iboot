<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.wc.WcMapper">

    <sql id="selectColumns">
        w.*,
        ws.code AS workshop_code,
        ws.name AS workshop_name
    </sql>

    <sql id="joinTables">
        FROM mdm_wc w
        LEFT JOIN mdm_workshop ws ON ws.id = w.workshop_id AND ws.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            w.deleted = 0
            <if test="req.workshopId != null">AND w.workshop_id = #{req.workshopId}</if>
            <if test="req.code != null and req.code != ''">AND w.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND w.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.status != null">AND w.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND w.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND w.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.wc.vo.WcRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY w.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.wc.vo.WcRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE w.deleted = 0 AND w.id = #{id}
    </select>

</mapper>
