<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.workshop.WorkshopMapper">

    <sql id="selectColumns">
        ws.*,
        p.code AS plant_code,
        p.name AS plant_name
    </sql>

    <sql id="joinTables">
        FROM mdm_workshop ws
        LEFT JOIN mdm_plant p ON p.id = ws.plant_id AND p.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            ws.deleted = 0
            <if test="req.plantId != null">AND ws.plant_id = #{req.plantId}</if>
            <if test="req.code != null and req.code != ''">AND ws.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND ws.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.status != null">AND ws.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND ws.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND ws.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.workshop.vo.WorkshopRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY ws.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.workshop.vo.WorkshopRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE ws.deleted = 0 AND ws.id = #{id}
    </select>

</mapper>
