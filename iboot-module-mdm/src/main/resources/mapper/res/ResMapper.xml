<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.res.ResMapper">

    <sql id="selectColumns">
        r.*,
        w.code AS wc_code,
        w.name AS wc_name
    </sql>

    <sql id="joinTables">
        FROM mdm_res r
        LEFT JOIN mdm_wc w ON w.id = r.wc_id AND w.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            r.deleted = 0
            <if test="req.wcId != null">AND r.wc_id = #{req.wcId}</if>
            <if test="req.resType != null and req.resType != ''">AND r.res_type = #{req.resType}</if>
            <if test="req.code != null and req.code != ''">AND r.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND r.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.status != null">AND r.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND r.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND r.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.res.vo.ResRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY r.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.res.vo.ResRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE r.deleted = 0 AND r.id = #{id}
    </select>

    <select id="selectSimpleList" resultType="com.iboot.pf.module.mdm.controller.admin.res.vo.ResSimpleRespVO">
        SELECT
        r.id,
        r.code,
        r.name,
        r.res_type,
        r.wc_id,
        w.name AS wc_name
        <include refid="joinTables"/>
        <where>
            r.deleted = 0
            <if test="req.ids != null and req.ids.size() > 0">
                AND r.id IN
                <foreach collection="req.ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="req.wcId != null">AND r.wc_id = #{req.wcId}</if>
            <if test="req.resType != null and req.resType != ''">AND r.res_type = #{req.resType}</if>
            <if test="req.status != null">AND r.status = #{req.status}</if>
        </where>
        ORDER BY r.code
    </select>

</mapper>
