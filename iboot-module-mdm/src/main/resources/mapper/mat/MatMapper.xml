<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iboot.pf.module.mdm.dal.mysql.mat.MatMapper">

    <sql id="selectColumns">
        m.*,
        c.code AS cat_code,
        c.name AS cat_name,
        u.code AS base_uom_code,
        u.name AS base_uom_name
    </sql>

    <sql id="joinTables">
        FROM mdm_mat m
        LEFT JOIN mdm_mat_cat c ON c.id = m.cat_id AND c.deleted = 0
        LEFT JOIN mdm_uom u ON u.id = m.base_uom_id AND u.deleted = 0
    </sql>

    <sql id="whereConditions">
        <where>
            m.deleted = 0
            <if test="req.catId != null">AND m.cat_id = #{req.catId}</if>
            <if test="req.code != null and req.code != ''">AND m.code = #{req.code}</if>
            <if test="req.name != null and req.name != ''">AND m.name LIKE CONCAT('%', #{req.name}, '%')</if>
            <if test="req.spec != null and req.spec != ''">AND m.spec = #{req.spec}</if>
            <if test="req.drawingNo != null and req.drawingNo != ''">AND m.drawing_no = #{req.drawingNo}</if>
            <if test="req.matType != null and req.matType != ''">AND m.mat_type = #{req.matType}</if>
            <if test="req.baseUomId != null">AND m.base_uom_id = #{req.baseUomId}</if>
            <if test="req.batchFlag != null">AND m.batch_flag = #{req.batchFlag}</if>
            <if test="req.snFlag != null">AND m.sn_flag = #{req.snFlag}</if>
            <if test="req.shelfLifeDays != null">AND m.shelf_life_days = #{req.shelfLifeDays}</if>
            <if test="req.status != null">AND m.status = #{req.status}</if>
            <if test="req.remark != null and req.remark != ''">AND m.remark = #{req.remark}</if>
            <if test="req.createTime != null and req.createTime.length == 2">
                AND m.create_time BETWEEN #{req.createTime[0]} AND #{req.createTime[1]}
            </if>
        </where>
    </sql>

    <select id="selectJoinPage" resultType="com.iboot.pf.module.mdm.controller.admin.mat.vo.MatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        <include refid="whereConditions"/>
        ORDER BY m.id DESC
    </select>

    <select id="selectJoinById" resultType="com.iboot.pf.module.mdm.controller.admin.mat.vo.MatRespVO">
        SELECT
        <include refid="selectColumns"/>
        <include refid="joinTables"/>
        WHERE m.deleted = 0 AND m.id = #{id}
    </select>

</mapper>
